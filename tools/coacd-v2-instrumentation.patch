--- /dev/null
+++ b/src/trace_hook.cpp
@@ -0,0 +1,329 @@
+#include "trace_hook.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <mutex>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#ifdef _WIN32
+#define COACD_STAT _stat
+#define COACD_STAT_STRUCT struct _stat
+#else
+#define COACD_STAT stat
+#define COACD_STAT_STRUCT struct stat
+#endif
+
+namespace coacd {
+namespace trace {
+
+namespace {
+
+struct TraceState {
+    std::string trace_dir;
+    bool enabled = false;
+    FILE* jsonl_fp = nullptr;
+    int current_call_id = -1;
+    bool initialized = false;
+    int clip_counter = 0;
+};
+
+TraceState g_state;
+std::mutex g_mutex;
+
+bool dir_exists(const std::string& path) {
+    if (path.empty()) return false;
+    COACD_STAT_STRUCT st;
+    if (COACD_STAT(path.c_str(), &st) != 0) return false;
+#ifdef _WIN32
+    return (st.st_mode & _S_IFDIR) != 0;
+#else
+    return S_ISDIR(st.st_mode);
+#endif
+}
+
+// Writes a NumPy v1.0 .npy file header + raw binary data.
+void write_npy_header(FILE* fp, const char* descr, size_t rows, size_t cols) {
+    char shape_buf[128];
+    std::snprintf(shape_buf, sizeof(shape_buf), "(%zu, %zu)", rows, cols);
+
+    std::string header = "{'descr': '";
+    header += descr;
+    header += "', 'fortran_order': False, 'shape': ";
+    header += shape_buf;
+    header += ", }";
+
+    // magic(6) + version(2) + header_len(2) = 10 bytes prefix.
+    // Total (10 + header_len) must be a multiple of 64; header ends with '\n'.
+    size_t base_len = header.size() + 1; // +1 for trailing '\n'
+    size_t total_len = 10 + base_len;
+    size_t padded_total = ((total_len + 63) / 64) * 64;
+    size_t pad = padded_total - total_len;
+    header.append(pad, ' ');
+    header += "\n";
+
+    unsigned char magic[6] = {0x93, 'N', 'U', 'M', 'P', 'Y'};
+    unsigned char version[2] = {0x01, 0x00};
+    unsigned short header_len = static_cast<unsigned short>(header.size());
+
+    std::fwrite(magic, 1, 6, fp);
+    std::fwrite(version, 1, 2, fp);
+    std::fwrite(&header_len, sizeof(unsigned short), 1, fp);
+    std::fwrite(header.data(), 1, header.size(), fp);
+}
+
+void write_npy(const std::string& path, const double* data, size_t rows, size_t cols) {
+    FILE* fp = std::fopen(path.c_str(), "wb");
+    if (!fp) return;
+    write_npy_header(fp, "<f8", rows, cols);
+    if (rows > 0 && cols > 0) {
+        std::fwrite(data, sizeof(double), rows * cols, fp);
+    }
+    std::fclose(fp);
+}
+
+void write_npy_int(const std::string& path, const int* data, size_t rows, size_t cols) {
+    FILE* fp = std::fopen(path.c_str(), "wb");
+    if (!fp) return;
+    write_npy_header(fp, "<i4", rows, cols);
+    if (rows > 0 && cols > 0) {
+        std::fwrite(data, sizeof(int), rows * cols, fp);
+    }
+    std::fclose(fp);
+}
+
+void write_npy_short(const std::string& path, const short* data, size_t rows, size_t cols) {
+    FILE* fp = std::fopen(path.c_str(), "wb");
+    if (!fp) return;
+    write_npy_header(fp, "<i2", rows, cols);
+    if (rows > 0 && cols > 0) {
+        std::fwrite(data, sizeof(short), rows * cols, fp);
+    }
+    std::fclose(fp);
+}
+
+std::string join_path(const std::string& dir, const std::string& name) {
+    if (!dir.empty() && (dir.back() == '/' || dir.back() == '\\')) {
+        return dir + name;
+    }
+    return dir + "/" + name;
+}
+
+void write_model_npy(const Model& model, const std::string& verts_path,
+                     const std::string& faces_path) {
+    const double* verts_data = model.points.empty() ? nullptr
+        : reinterpret_cast<const double*>(model.points.data());
+    write_npy(verts_path, verts_data, model.points.size(), 3);
+
+    const int* faces_data = model.triangles.empty() ? nullptr
+        : reinterpret_cast<const int*>(model.triangles.data());
+    write_npy_int(faces_path, faces_data, model.triangles.size(), 3);
+}
+
+} // namespace
+
+thread_local int current_component_id = -1;
+
+void init() {
+    const char* env = std::getenv("COACD_TRACE_DIR");
+    if (env == nullptr || std::strlen(env) == 0) {
+        g_state.enabled = false;
+        g_state.initialized = true;
+        return;
+    }
+    g_state.trace_dir = env;
+    g_state.enabled = dir_exists(g_state.trace_dir);
+    g_state.initialized = true;
+}
+
+bool active() {
+    return g_state.enabled;
+}
+
+void begin_decomposition(int call_id, const Model& input_mesh) {
+    if (!g_state.initialized) {
+        init();
+    }
+    if (!g_state.enabled) return;
+
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    g_state.current_call_id = call_id;
+    g_state.clip_counter = 0;
+
+    std::string jsonl_path = join_path(g_state.trace_dir, std::to_string(call_id) + ".jsonl");
+    g_state.jsonl_fp = std::fopen(jsonl_path.c_str(), "w");
+
+    std::string verts_name = std::to_string(call_id) + "_input_verts.npy";
+    std::string faces_name = std::to_string(call_id) + "_input_faces.npy";
+    std::string verts_path = join_path(g_state.trace_dir, verts_name);
+    std::string faces_path = join_path(g_state.trace_dir, faces_name);
+
+    write_model_npy(input_mesh, verts_path, faces_path);
+
+    if (g_state.jsonl_fp) {
+        std::fprintf(g_state.jsonl_fp,
+            "{\"event\":\"begin\",\"call_id\":%d,\"input_verts\":\"%s\",\"input_faces\":\"%s\",\"num_vertices\":%zu,\"num_faces\":%zu}\n",
+            call_id, verts_name.c_str(), faces_name.c_str(),
+            input_mesh.points.size(), input_mesh.triangles.size());
+    }
+}
+
+void record_plane(const Plane& plane, const char* generation_method, int plane_index) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"plane\",\"a\":%.17g,\"b\":%.17g,\"c\":%.17g,\"d\":%.17g,\"method\":\"%s\",\"index\":%d}\n",
+        plane.a, plane.b, plane.c, plane.d, generation_method, plane_index);
+}
+
+void record_clip(int component_id, const Plane& plane,
+                 const Model& pos, const Model& neg,
+                 int intersection_count) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+
+    int call_id = g_state.current_call_id;
+    std::string pos_verts_name = std::to_string(call_id) + "_clip_" + std::to_string(component_id) + "_pos_verts.npy";
+    std::string pos_faces_name = std::to_string(call_id) + "_clip_" + std::to_string(component_id) + "_pos_faces.npy";
+    std::string neg_verts_name = std::to_string(call_id) + "_clip_" + std::to_string(component_id) + "_neg_verts.npy";
+    std::string neg_faces_name = std::to_string(call_id) + "_clip_" + std::to_string(component_id) + "_neg_faces.npy";
+
+    // .npy writes outside lock — unique filenames per component, no race
+    write_model_npy(pos, join_path(g_state.trace_dir, pos_verts_name), join_path(g_state.trace_dir, pos_faces_name));
+    write_model_npy(neg, join_path(g_state.trace_dir, neg_verts_name), join_path(g_state.trace_dir, neg_faces_name));
+
+    std::lock_guard<std::mutex> lock(g_mutex);
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"clip\",\"component_id\":%d,\"a\":%.17g,\"b\":%.17g,\"c\":%.17g,\"d\":%.17g,"
+        "\"pos_verts\":\"%s\",\"pos_faces\":\"%s\",\"neg_verts\":\"%s\",\"neg_faces\":\"%s\","
+        "\"pos_num_vertices\":%zu,\"pos_num_faces\":%zu,\"neg_num_vertices\":%zu,\"neg_num_faces\":%zu,"
+        "\"intersection_count\":%d}\n",
+        component_id, plane.a, plane.b, plane.c, plane.d,
+        pos_verts_name.c_str(), pos_faces_name.c_str(), neg_verts_name.c_str(), neg_faces_name.c_str(),
+        pos.points.size(), pos.triangles.size(), neg.points.size(), neg.triangles.size(),
+        intersection_count);
+}
+
+void record_clip_oracle(int component_id, const Plane& plane,
+                        const Model& input_mesh,
+                        const std::vector<short>& vertex_sides,
+                        const Model& pos, const Model& neg,
+                        const std::vector<vec3d>& border,
+                        int intersection_count) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+
+    int call_id = g_state.current_call_id;
+    int clip_idx = g_state.clip_counter++;
+    std::string prefix = std::to_string(call_id) + "_clip_" + std::to_string(clip_idx);
+
+    std::string pos_verts_name = prefix + "_pos_verts.npy";
+    std::string pos_faces_name = prefix + "_pos_faces.npy";
+    std::string neg_verts_name = prefix + "_neg_verts.npy";
+    std::string neg_faces_name = prefix + "_neg_faces.npy";
+    std::string input_verts_name = prefix + "_input_verts.npy";
+    std::string input_faces_name = prefix + "_input_faces.npy";
+    std::string oracle_sides_name = prefix + "_oracle_sides.npy";
+    std::string cut_points_name = prefix + "_cut_points.npy";
+
+    // .npy writes outside lock — unique filenames per monotonic clip index
+    write_model_npy(pos, join_path(g_state.trace_dir, pos_verts_name), join_path(g_state.trace_dir, pos_faces_name));
+    write_model_npy(neg, join_path(g_state.trace_dir, neg_verts_name), join_path(g_state.trace_dir, neg_faces_name));
+    write_model_npy(input_mesh, join_path(g_state.trace_dir, input_verts_name), join_path(g_state.trace_dir, input_faces_name));
+
+    const short* sides_data = vertex_sides.empty() ? nullptr : vertex_sides.data();
+    write_npy_short(join_path(g_state.trace_dir, oracle_sides_name), sides_data, vertex_sides.size(), 1);
+
+    const double* border_data = border.empty() ? nullptr
+        : reinterpret_cast<const double*>(border.data());
+    write_npy(join_path(g_state.trace_dir, cut_points_name), border_data, border.size(), 3);
+
+    std::lock_guard<std::mutex> lock(g_mutex);
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"clip\",\"component_id\":%d,\"a\":%.17g,\"b\":%.17g,\"c\":%.17g,\"d\":%.17g,"
+        "\"pos_verts\":\"%s\",\"pos_faces\":\"%s\",\"neg_verts\":\"%s\",\"neg_faces\":\"%s\","
+        "\"input_verts\":\"%s\",\"input_faces\":\"%s\",\"oracle_sides\":\"%s\",\"cut_points\":\"%s\","
+        "\"pos_num_vertices\":%zu,\"pos_num_faces\":%zu,\"neg_num_vertices\":%zu,\"neg_num_faces\":%zu,"
+        "\"intersection_count\":%d}\n",
+        component_id, plane.a, plane.b, plane.c, plane.d,
+        pos_verts_name.c_str(), pos_faces_name.c_str(), neg_verts_name.c_str(), neg_faces_name.c_str(),
+        input_verts_name.c_str(), input_faces_name.c_str(), oracle_sides_name.c_str(), cut_points_name.c_str(),
+        pos.points.size(), pos.triangles.size(), neg.points.size(), neg.triangles.size(),
+        intersection_count);
+}
+
+void record_cost(int component_id, double rv, double hb, double energy) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"cost\",\"component_id\":%d,\"rv\":%.17g,\"hb\":%.17g,\"energy\":%.17g}\n",
+        component_id, rv, hb, energy);
+}
+
+void record_mcts(int iteration, double reward, int worst_part_idx, int visit_count) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"mcts\",\"iteration\":%d,\"reward\":%.17g,\"worst_part\":%d,\"visits\":%d}\n",
+        iteration, reward, worst_part_idx, visit_count);
+}
+
+void record_component_state(int iteration, int component_index,
+                            const Model& mesh, const Model& convex_hull) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    int call_id = g_state.current_call_id;
+    std::string prefix = std::to_string(call_id) + "_state_" + std::to_string(iteration) + "_" + std::to_string(component_index);
+    std::string mesh_verts_name = prefix + "_mesh_verts.npy";
+    std::string mesh_faces_name = prefix + "_mesh_faces.npy";
+    std::string hull_verts_name = prefix + "_hull_verts.npy";
+    std::string hull_faces_name = prefix + "_hull_faces.npy";
+
+    write_model_npy(mesh, join_path(g_state.trace_dir, mesh_verts_name), join_path(g_state.trace_dir, mesh_faces_name));
+    write_model_npy(convex_hull, join_path(g_state.trace_dir, hull_verts_name), join_path(g_state.trace_dir, hull_faces_name));
+
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"component_state\",\"iteration\":%d,\"component_index\":%d,"
+        "\"mesh_verts\":\"%s\",\"mesh_faces\":\"%s\",\"hull_verts\":\"%s\",\"hull_faces\":\"%s\"}\n",
+        iteration, component_index,
+        mesh_verts_name.c_str(), mesh_faces_name.c_str(), hull_verts_name.c_str(), hull_faces_name.c_str());
+}
+
+void end_decomposition(const std::vector<Model>& output_parts) {
+    if (!g_state.enabled || !g_state.jsonl_fp) return;
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    int call_id = g_state.current_call_id;
+    std::vector<std::string> part_files;
+    part_files.reserve(output_parts.size() * 2);
+
+    for (size_t i = 0; i < output_parts.size(); ++i) {
+        std::string verts_name = std::to_string(call_id) + "_output_" + std::to_string(i) + "_verts.npy";
+        std::string faces_name = std::to_string(call_id) + "_output_" + std::to_string(i) + "_faces.npy";
+        write_model_npy(output_parts[i], join_path(g_state.trace_dir, verts_name), join_path(g_state.trace_dir, faces_name));
+        part_files.push_back(verts_name);
+        part_files.push_back(faces_name);
+    }
+
+    std::string files_json = "[";
+    for (size_t i = 0; i < part_files.size(); ++i) {
+        if (i > 0) files_json += ",";
+        files_json += "\"";
+        files_json += part_files[i];
+        files_json += "\"";
+    }
+    files_json += "]";
+
+    std::fprintf(g_state.jsonl_fp,
+        "{\"event\":\"end\",\"num_parts\":%zu,\"part_files\":%s}\n",
+        output_parts.size(), files_json.c_str());
+
+    std::fclose(g_state.jsonl_fp);
+    g_state.jsonl_fp = nullptr;
+}
+
