+namespace coacd {
+namespace trace {
+
+// Call once at library load / first use. Reads COACD_TRACE_DIR env var.
+// If unset or empty, all hooks are no-ops.
+void init();
+
+// Returns true if tracing is active (COACD_TRACE_DIR was set and valid).
+bool active();
+
+// Begin a new decomposition trace. call_id is a monotonic counter.
+// Opens <trace_dir>/<call_id>.jsonl for writing.
+void begin_decomposition(int call_id, const Model& input_mesh);
+
+// Hook 1: A candidate cutting plane was generated.
+// generation_method: "axis_aligned" or "ternary_refine"
+void record_plane(const Plane& plane, const char* generation_method, int plane_index);
+
+// Hook 2: A clip operation completed.
+void record_clip(int component_id, const Plane& plane,
+                 const Model& pos, const Model& neg,
+                 int intersection_count);
+
+// Hook 2b: Per-vertex Side decisions and input mesh at Clip() entry.
+void record_clip_oracle(int component_id, const Plane& plane,
+                        const Model& input_mesh,
+                        const std::vector<short>& vertex_sides,
+                        const Model& pos, const Model& neg,
+                        const std::vector<vec3d>& border,
+                        int intersection_count);
+
+// Hook 3: Cost computed for a component pair.
+void record_cost(int component_id, double rv, double hb, double energy);
+
+// Hook 4: MCTS reward computed.
+void record_mcts(int iteration, double reward, int worst_part_idx, int visit_count);
+
+// Hook 5: Component state at end of an iteration of the main loop.
+// Writes vertex/face arrays as .npy binary blobs.
+void record_component_state(int iteration, int component_index,
+                            const Model& mesh, const Model& convex_hull);
+
+// Finalize: write output hulls and close the JSONL file.
+void end_decomposition(const std::vector<Model>& output_parts);
+
+// Thread-local component id for clip hook (set by process.cpp parallel lambda)
+extern thread_local int current_component_id;
+
