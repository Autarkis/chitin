 run_tests.py               | 12 ++++++++----
 setup.py                   | 10 +++++-----
 src/clip.cpp               | 11 +++++++++++
 src/cost.cpp               |  2 ++
 src/mcts.cpp               |  8 ++++++++
 src/process.cpp            | 17 +++++++++++++++++
 7 files changed, 54 insertions(+), 10 deletions(-)

