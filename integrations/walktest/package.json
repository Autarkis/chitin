{
  "name": "@autarkis/chitin-walktest",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright-driven physics walk test for .phys sidecars",
  "type": "module",
  "scripts": {
    "build": "esbuild harness/scene.ts --bundle --outfile=harness/dist/scene.js --format=esm --platform=browser",
    "build:spark-demo": "esbuild harness/spark-demo.ts --bundle --outfile=harness/dist/spark-demo.js --format=esm --platform=browser",
    "build:release-candidate": "esbuild harness/release-candidate.ts --bundle --outfile=harness/dist/release-candidate.js --format=esm --platform=browser",
    "demo:spark": "npm run prepare:release-candidate && npm run build:spark-demo && serve harness -l 3219",
    "prepare:release-candidate": "node scripts/prepare-release-candidate.mjs",
    "pretest": "npm run build",
    "test": "npx playwright test tests/walktest.spec.ts",
    "test:release-candidate": "npm run prepare:release-candidate && npm run build:release-candidate && npx playwright test tests/release-candidate.spec.ts",
    "test:headed": "npx playwright test tests/walktest.spec.ts --headed"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@playwright/test": "^1.62.1",
    "@sparkjsdev/spark": "2.1.0",
    "esbuild": "^0.28.2",
    "serve": "^14.2.6",
    "three": "^0.186.1"
  }
}
