{
  "name": "@autarkis/chitin-web",
  "version": "0.2.0",
  "description": "Load chitin .phys sidecars and attach them to web runtimes",
  "keywords": [
    "physics",
    "collision",
    "collider",
    "convex-hull",
    "three",
    "threejs",
    "rapier",
    "gltf",
    "glb",
    "robotics",
    "webgl",
    "gaussian-splatting",
    "spark",
    "phys"
  ],
  "homepage": "https://github.com/Autarkis/chitin#readme",
  "bugs": "https://github.com/Autarkis/chitin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Autarkis/chitin.git",
    "directory": "integrations/web"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rapier": {
      "types": "./dist/rapier.d.ts",
      "import": "./dist/rapier.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./spark": {
      "types": "./dist/spark.d.ts",
      "import": "./dist/spark.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": ">=0.13",
    "@sparkjsdev/spark": ">=2.1 <3",
    "three": ">=0.180"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "@sparkjsdev/spark": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@sparkjsdev/spark": "2.1.0",
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
